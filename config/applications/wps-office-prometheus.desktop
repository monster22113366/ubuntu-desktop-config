[Desktop Entry]
Comment=Use WPS Writer to office work.
Comment[zh_CN]=使用 WPS Office进行办公
TryExec=/usr/bin/wps
Exec=sh -c "exec \\"\\$HOME/.local/bin/wps-hidpi\\" \\"\\$@\\"" wps-hidpi /usr/bin/wps %F
GenericName=WPS
GenericName[zh_CN]=WPS Office
Name=WPS Office
Name[zh_CN]=WPS Office
StartupNotify=false
Terminal=false
Type=Application
Categories=WordProcessor;Qt;
X-DBUS-ServiceName=
X-DBUS-StartupType=
X-KDE-SubstituteUID=false
X-KDE-Username=
Icon=wps-office2023-kprometheus
InitialPreference=3
StartupWMClass=wpsoffice
