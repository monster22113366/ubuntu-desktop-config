{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "exclusive": true,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "network",
        "custom/proxy",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "disable-scroll": true,
        "all-outputs": false
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 35,
        "separate-outputs": true
    },
    "network": {
        "interval": 5,
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "Wi-Fi: {essid}\n信号强度: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "接口: {ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "网络未连接",
        "on-click": "\"$HOME/Projects/ubuntu-desktop-config/config/scripts/network-control.sh\"",
        "format-disabled": "󰤭",
        "tooltip-format-disabled": "Wi-Fi 已关闭｜点击打开网络控制",
        "family": "ipv4_6"
    },
    "custom/proxy": {
        "exec": "bash ~/.config/waybar/scripts/proxy.sh",
        "return-type": "json",
        "interval": 30,
        "format": "{}",
        "tooltip": true
    },
    "battery": {
        "bat": "BAT1",
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "tooltip": true
    },
    "clock": {
        "interval": 1,
        "format": "󰥔 {:%H:%M}",
        "tooltip": true,
        "tooltip-format": "{:%Y-%m-%d %A}"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6
    },
    "custom/power": {
        "exec": "echo '󰐥'",
        "interval": "once",
        "format": "{}",
        "on-click": "bash ~/.config/waybar/scripts/power-menu.sh",
        "tooltip": true,
        "tooltip-format": "电源菜单"
    }
}
